import * as vscode from 'vscode';
import * as path from 'path';
import ffmpeg from '../cli/ffmpeg';
import ffprobe from '../cli/ffprobe';
import { EventEmitter } from 'vscode';
import { Util } from '../util';
import MP4 from '../mp4';
import VideoItem from './video-item';
import VideoInfo from '../cli/video-info';

export class VideoDataSource {
    public static readonly shared = new VideoDataSource();

    private _refreshPromise: Promise<void> | null = null;

    private data = {
        onDidChangeVideos: new EventEmitter<void>(),
        videos: [] as VideoItem[],
        hevcVideos: [] as VideoItem[],
        otherVideos: [] as VideoItem[],
        isLoading: false,
        conversions: new Map<string, boolean>(),
    };

    public readonly onDidChangeVideos = this.data.onDidChangeVideos.event;

    public readonly excludedDirectories = [
        'external',
        'bazel-*',
        'node_modules',
        '.git',
        '.build',
        'build',
    ];
    
    public get isRefreshing(): boolean {
        return this._refreshPromise !== null;
    }

    public get videos(): VideoItem[] {
        return this.data.videos;
    }

    public get hevcVideos(): VideoItem[] {
        return this.data.hevcVideos;
    }

    public get otherVideos(): VideoItem[] {
        return this.data.otherVideos;
    }

    public get isLoading(): boolean {
        return this.data.isLoading;
    }

    public isConverting(path: string): boolean {
        return !!this.data.conversions.get(path);
    }

    private async _refresh() {

        this.data.isLoading = true;
        this.data.videos = [];
        this.data.hevcVideos = [];
        this.data.otherVideos = [];

        try {
            // Find video files in workspace
            const excludeGlob = `{${this.excludedDirectories.join(',')}}/`;

            // Get video extensions from configuration
            const config = require('../config').default;
            const videoExtensions = config.videoExtensions || ['mp4', 'mov', 'mkv'];

            const videosGlob = `**/*.{${videoExtensions.join(',')}}`;

            const videoURIs = await vscode.workspace.findFiles(videosGlob, excludeGlob);

            // Process each video file
            for (const uri of videoURIs) {
                const filename = path.basename(uri.fsPath);
                const isConverting = this.data.conversions.get(uri.fsPath) || false;

                const isHEVC = MP4.isHEVC(uri.fsPath);
                
                // Try to get duration directly from MP4 file
                const duration = MP4.getDuration(uri.fsPath);
                
                // Create video info with the data we have
                const info: VideoInfo = {
                    codec: isHEVC ? 'hevc' : 'unknown',
                    isHEVC,
                    filename,
                    duration,
                };

                const videoItem = new VideoItem(uri, info, filename, isConverting);
                this.data.videos.push(videoItem);

                if (isHEVC) {
                    this.data.hevcVideos.push(videoItem);
                } else {
                    this.data.otherVideos.push(videoItem);
                }
            }

            // Sort videos alphabetically
            [this.data.videos, this.data.hevcVideos, this.data.otherVideos].forEach(arr => {
                arr.sort((a, b) => a.label.localeCompare(b.label));
            });
        } finally { }
    }

    public async refresh(): Promise<void> {
        // If a refresh is already in progress, return the existing promise
        if (this._refreshPromise) {
            return this._refreshPromise;
        }
        
        const start = Date.now();
        
        // Start the refresh and ensure it takes at least 1 second
        this._refreshPromise = this._refresh().then(async () => {
            const elapsed = Date.now() - start;
            if (elapsed < 1000) {
                // Wait the remaining time to reach 1 second
                await new Promise(resolve => setTimeout(resolve, 1000 - elapsed));
                console.log('Done');
            }
        }).finally(() => {
            // Clear the refresh promise when done
            this._refreshPromise = null;
            this.data.isLoading = false;
            this.data.onDidChangeVideos.fire();
        });
        
        return this._refreshPromise;
    }

    public async convertToHEVC(
        videoItem: VideoItem, 
        cancellationToken?: vscode.CancellationToken,
        options?: { progressLocation?: vscode.ProgressLocation }
    ) {
        ffmpeg.guardCanUseFFmpeg();

        // Check if already converting
        if (this.data.conversions.get(videoItem.uri.fsPath)) {
            vscode.window.showInformationMessage(`Already converting ${videoItem.label}`);
            return false;
        }

        // Mark as converting
        this.data.conversions.set(videoItem.uri.fsPath, true);
        this.data.onDidChangeVideos.fire();

        let success = false;

        try {
            // Always show progress notification, but location might differ
            await vscode.window.withProgress({
                location: options?.progressLocation || vscode.ProgressLocation.Notification,
                title: `Converting ${videoItem.label} to HEVC`,
                cancellable: true
            }, async (progress, progressCancellationToken) => {
                // Combine the cancellation tokens
                const combinedToken = Util.combineCancellationTokens(
                    progressCancellationToken, cancellationToken
                );

                progress.report({ increment: 0 });

                try {
                    // Start conversion with cancellation token
                    await ffmpeg.transcode({
                        input: videoItem.uri.fsPath,
                        output: this.chooseNewFilename.bind(this),
                        overwrite: true,
                    }, combinedToken);

                    if (!combinedToken?.isCancellationRequested) {
                        progress.report({ increment: 100 });
                        // Show success message
                        vscode.window.showInformationMessage(
                            `Converted ${videoItem.label} to HEVC`
                        );
                        success = true;
                    }
                } catch (error) {
                    if (combinedToken?.isCancellationRequested) {
                        vscode.window.showInformationMessage(
                            `Aborting conversion of ${videoItem.label}`
                        );
                    } else {
                        throw error;
                    }
                }
            });
        } finally {
            // Mark as not converting
            this.data.conversions.delete(videoItem.uri.fsPath);
            this.data.onDidChangeVideos.fire();
        }

        return success;
    }

    public async convertAllToHEVC(cancellationToken?: vscode.CancellationToken): Promise<void> {
        ffmpeg.guardCanUseFFmpeg();

        if (this.data.otherVideos.length === 0) {
            return;
        }

        const totalCount = this.data.otherVideos.length;
        let converted = 0;

        await vscode.window.withProgress({
            location: vscode.ProgressLocation.Notification,
            title: `Converting ${totalCount} videos to HEVC`,
            cancellable: true
        }, async (progress, progressCancellationToken) => {
            // Combine the cancellation tokens
            const combinedToken = Util.combineCancellationTokens(
                progressCancellationToken, cancellationToken
            );

            // Convert videos one by one
            for (const video of this.data.otherVideos) {
                // Check for cancellation before starting each video
                if (combinedToken?.isCancellationRequested) {
                    break;
                }

                // Skip already converting videos
                if (this.data.conversions.get(video.uri.fsPath)) {
                    continue;
                }

                progress.report({
                    increment: 100 / totalCount,
                    message: `(${converted + 1}/${totalCount}) ${video.label}`
                });

                // Use the singular method with a different progress location
                const success = await this.convertToHEVC(video, combinedToken, {
                    progressLocation: vscode.ProgressLocation.Window
                });
                
                if (success) {
                    converted++;
                } else if (combinedToken?.isCancellationRequested) {
                    break;
                }
            }
        });

        if (cancellationToken?.isCancellationRequested || converted < totalCount) {
            vscode.window.showInformationMessage(
                `Converted ${converted}/${totalCount} videos to HEVC (operation was cancelled)`
            );
        } else {
            vscode.window.showInformationMessage(
                `Converted ${converted}/${totalCount} videos to HEVC`
            );
        }
        await this.refresh();
    }
    
    public async chooseNewFilename(defaultFilename: string): Promise<string | undefined> {
        return await vscode.window.showInputBox({
            title: 'Choose Output Filename',
            prompt: 'The auto-generated filename already exists. Enter a new name.',
            value: defaultFilename,
            placeHolder: 'video.mp4'
        });
    }

    public async recodeHEVC(
        videoItem: VideoItem, 
        cancellationToken?: vscode.CancellationToken,
        options?: { crf?: number, progressLocation?: vscode.ProgressLocation }
    ) {
        ffmpeg.guardCanUseFFmpeg();

        // Check if the video is HEVC
        if (!videoItem.info?.isHEVC) {
            throw new Error('Only HEVC videos can be re-encoded with this command');
        }

        // Check if already converting
        if (this.data.conversions.get(videoItem.uri.fsPath)) {
            vscode.window.showInformationMessage(`Already processing ${videoItem.label}`);
            return false;
        }

        // Get CRF value - either from options or prompt user
        let crf: number;
        
        if (options?.crf !== undefined) {
            crf = options.crf;
        } else {
            // Prompt for CRF value (0-51, lower is better quality but larger file)
            const crfInput = await vscode.window.showInputBox({
                title: 'Enter CRF Value',
                prompt: 'Specify a CRF value (0-51, lower is better quality). Recommended: 18-28',
                placeHolder: '23',
                validateInput: (value) => {
                    const num = parseInt(value, 10);
                    if (isNaN(num)) {
                        return 'Please enter a valid number';
                    }
                    if (num < 0 || num > 51) {
                        return 'CRF value must be between 0 and 51';
                    }
                    return null; // Valid input
                }
            });

            // If user cancelled, abort
            if (!crfInput) {
                return false;
            }

            crf = parseInt(crfInput, 10);
        }

        // Mark as converting
        this.data.conversions.set(videoItem.uri.fsPath, true);
        this.data.onDidChangeVideos.fire();

        let success = false;

        try {
            // Create output filename generator function
            const customOutputNamer = async (defaultPath: string): Promise<string | undefined> => {
                const dir = path.dirname(defaultPath);
                const ext = path.extname(defaultPath);
                const baseName = path.basename(defaultPath, ext);
                
                // Add CRF to the filename
                const newBaseName = baseName.replace('.hevc', '') + `.crf${crf}`;
                const newPath = path.join(dir, `${newBaseName}${ext}`);
                
                // Check if the file already exists
                try {
                    await vscode.workspace.fs.stat(vscode.Uri.file(newPath));
                    // File exists, prompt for a new name
                    return this.chooseNewFilename(newPath);
                } catch {
                    // File doesn't exist, use this path
                    return newPath;
                }
            };

            // Always show progress notification
            await vscode.window.withProgress({
                location: options?.progressLocation || vscode.ProgressLocation.Notification,
                title: `Re-encoding ${videoItem.label} with CRF ${crf}`,
                cancellable: true
            }, async (progress, progressCancellationToken) => {
                // Combine the cancellation tokens
                const combinedToken = Util.combineCancellationTokens(
                    progressCancellationToken, cancellationToken
                );

                progress.report({ increment: 0 });

                try {
                    await ffmpeg.transcode({
                        input: videoItem.uri.fsPath,
                        output: customOutputNamer,
                        overwrite: true,
                        crf: crf
                    }, combinedToken);

                    if (!combinedToken?.isCancellationRequested) {
                        progress.report({ increment: 100 });
                        // Show success message
                        vscode.window.showInformationMessage(
                            `Re-encoded ${videoItem.label} with CRF ${crf}`
                        );
                        success = true;
                    }
                } catch (error) {
                    if (combinedToken?.isCancellationRequested) {
                        vscode.window.showInformationMessage(
                            `Aborting re-encoding of ${videoItem.label}`
                        );
                    } else {
                        throw error;
                    }
                }
            });
        } finally {
            // Mark as not converting
            this.data.conversions.delete(videoItem.uri.fsPath);
            this.data.onDidChangeVideos.fire();
        }

        return success;
    }

    public async recodeAllHEVC(cancellationToken?: vscode.CancellationToken): Promise<void> {
        ffmpeg.guardCanUseFFmpeg();

        if (this.data.hevcVideos.length === 0) {
            return;
        }

        // Prompt for CRF value once for all videos
        const crfInput = await vscode.window.showInputBox({
            title: 'Enter CRF Value for All Videos',
            prompt: 'Specify a CRF value (0-51, lower is better quality). Recommended: 18-28',
            placeHolder: '23',
            validateInput: (value) => {
                const num = parseInt(value, 10);
                if (isNaN(num)) {
                    return 'Please enter a valid number';
                }
                if (num < 0 || num > 51) {
                    return 'CRF value must be between 0 and 51';
                }
                return null; // Valid input
            }
        });

        // If user cancelled, abort
        if (!crfInput) {
            return;
        }

        const crf = parseInt(crfInput, 10);
        const totalCount = this.data.hevcVideos.length;
        let converted = 0;

        await vscode.window.withProgress({
            location: vscode.ProgressLocation.Notification,
            title: `Re-encoding ${totalCount} videos with CRF ${crf}`,
            cancellable: true
        }, async (progress, progressCancellationToken) => {
            // Combine the cancellation tokens
            const combinedToken = Util.combineCancellationTokens(
                progressCancellationToken, cancellationToken
            );

            // Convert videos one by one
            for (const video of this.data.hevcVideos) {
                // Check for cancellation before starting each video
                if (combinedToken?.isCancellationRequested) {
                    break;
                }

                // Skip already converting videos
                if (this.data.conversions.get(video.uri.fsPath)) {
                    continue;
                }

                progress.report({
                    increment: 100 / totalCount,
                    message: `(${converted + 1}/${totalCount}) ${video.label}`
                });

                // Use the singular method with a different progress location and pre-defined CRF
                const success = await this.recodeHEVC(video, combinedToken, {
                    progressLocation: vscode.ProgressLocation.Window,
                    crf
                });
                
                if (success) {
                    converted++;
                } else if (combinedToken?.isCancellationRequested) {
                    break;
                }
            }
        });

        if (cancellationToken?.isCancellationRequested || converted < totalCount) {
            vscode.window.showInformationMessage(
                `Re-encoded ${converted}/${totalCount} HEVC videos with CRF ${crf} (operation was cancelled)`
            );
        } else {
            vscode.window.showInformationMessage(
                `Re-encoded ${converted}/${totalCount} HEVC videos with CRF ${crf}`
            );
        }
        await this.refresh();
    }
}
