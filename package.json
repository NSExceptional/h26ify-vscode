{
    "name": "h26ify",
    "publisher": "tanner",
    "displayName": "H26ify",
    "description": "Identify, convert, and edit videos in your workspace — HEVC conversion plus trim, crop, and resize.",
    "version": "2026.9.16",
    "license": "MIT",
    "icon": "media/icon.png",
    "engines": {
        "vscode": "^1.100.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "video",
        "hevc",
        "h265",
        "ffmpeg",
        "convert",
        "transcode",
        "trim",
        "crop",
        "resize"
    ],
    "galleryBanner": {
        "color": "#1e1e1e",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/NSExceptional/h26ify-vscode.git"
    },
    "bugs": {
        "url": "https://github.com/NSExceptional/h26ify-vscode/issues"
    },
    "homepage": "https://github.com/NSExceptional/h26ify-vscode#readme",
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "configuration": {
            "title": "H26ify",
            "properties": {
                "h26ify.videoExtensions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "mp4",
                        "mov",
                        "avi",
                        "mkv",
                        "webm",
                        "flv",
                        "wmv"
                    ],
                    "description": "List of video file extensions to scan for"
                },
                "h26ify.outputNamePattern": {
                    "type": "string",
                    "default": "{filename}.{format}.{ext}",
                    "description": "Pattern for naming converted files. Use {filename}, {format}, {ext}, and {old-ext} as placeholders"
                },
                "h26ify.outputFileStrategy": {
                    "type": "string",
                    "enum": [
                        "useOriginalName",
                        "askForName",
                        "useTemplate"
                    ],
                    "default": "useTemplate",
                    "description": "How to determine the output filename: use original name, ask user for name, or use template pattern"
                },
                "h26ify.originalFileHandling": {
                    "type": "string",
                    "enum": [
                        "doNothing",
                        "trash",
                        "delete"
                    ],
                    "default": "trash",
                    "description": "What to do with the original file after conversion: leave in place, move to trash, or delete permanently"
                },
                "h26ify.overwriteExisting": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether to overwrite existing files that collide with the output filename"
                }
            }
        },
        "commands": [
            {
                "command": "h26ify.refreshVideos",
                "title": "Refresh Videos",
                "icon": "$(refresh)",
                "category": "H26ify",
                "progress": {
                    "view": "h26ify.videos"
                }
            },
            {
                "command": "h26ify.convertToHEVC",
                "title": "Convert to HEVC",
                "icon": "$(dashboard)",
                "category": "H26ify"
            },
            {
                "command": "h26ify.convertAllToHEVC",
                "title": "Convert All to HEVC",
                "icon": "$(zap)",
                "category": "H26ify"
            },
            {
                "command": "h26ify.recode",
                "title": "Reduce File Size",
                "icon": "$(filter)",
                "category": "H26ify"
            },
            {
                "command": "h26ify.recodeAll",
                "title": "Reduce All File Sizes",
                "icon": "$(filter)",
                "category": "H26ify"
            },
            {
                "command": "h26ify.editVideo",
                "title": "Edit Video…",
                "icon": "$(edit)",
                "category": "H26ify"
            },
            {
                "command": "h26ify.editSelectedVideos",
                "title": "Edit Selected Videos…",
                "icon": "$(edit)",
                "category": "H26ify",
                "isMultiSelect": true
            },
            {
                "command": "h26ify.editSelectionFromView",
                "title": "Edit Selected Videos…",
                "icon": "$(edit)",
                "category": "H26ify"
            },
            {
                "command": "h26ify.revealInFinder",
                "title": "Reveal in Finder",
                "icon": "$(folder-opened)",
                "category": "H26ify"
            }
        ],
        "views": {
            "explorer": [
                {
                    "id": "h26ify.videos",
                    "name": "Videos",
                    "icon": "$(device-camera-video)",
                    "contextualTitle": "Videos"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "h26ify.editSelectionFromView",
                    "when": "view == h26ify.videos",
                    "group": "navigation@1"
                },
                {
                    "command": "h26ify.refreshVideos",
                    "when": "view == h26ify.videos",
                    "group": "navigation@2"
                }
            ],
            "view/item/context": [
                {
                    "command": "h26ify.revealInFinder",
                    "when": "viewItem == video || viewItem == video-hevc",
                    "group": "inline@0"
                },
                {
                    "command": "h26ify.convertToHEVC",
                    "when": "viewItem == video",
                    "group": "inline"
                },
                {
                    "command": "h26ify.recode",
                    "when": "viewItem == video-hevc",
                    "group": "inline"
                },
                {
                    "command": "h26ify.convertAllToHEVC",
                    "when": "viewItem == category-other",
                    "group": "inline"
                },
                {
                    "command": "h26ify.recodeAll",
                    "when": "viewItem == category-hevc",
                    "group": "inline"
                },
                {
                    "command": "h26ify.editVideo",
                    "when": "viewItem == video || viewItem == video-hevc",
                    "group": "1_edit@1"
                },
                {
                    "command": "h26ify.editSelectedVideos",
                    "when": "viewItem == video || viewItem == video-hevc",
                    "group": "1_edit@2"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "20.x",
        "@types/vscode": "^1.100.0",
        "@typescript-eslint/eslint-plugin": "^8.31.1",
        "@typescript-eslint/parser": "^8.31.1",
        "@vscode/test-cli": "^0.0.10",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^9.25.1",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4"
    },
    "dependencies": {
        "lazy-get-decorator": "^3.0.0",
        "sudo-prompt": "^9.2.1",
        "trash": "^9.0.0"
    }
}
